{
  "name": "online-pharmacy-ordering-system",
  "version": "2.0.0",
  "description": "EE4207 Mini Project - Online Pharmacy Ordering System (MERN: MongoDB, Express, React, Node.js)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n api,web -c green,cyan \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "install-all": "npm install && npm install --prefix client",
    "seed": "node src/utils/seed.js"
  },
  "keywords": [
    "pharmacy",
    "mern",
    "react",
    "express",
    "mongodb",
    "crud"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7"
  }
}
