# Copy this file to .env and change the values

PORT=5000

# Local MongoDB:   mongodb://127.0.0.1:27017/pharmacy_db
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmacy_db
MONGO_URI=mongodb://127.0.0.1:27017/pharmacy_db

# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Optional: accounts created by "npm run seed" (defaults shown)
# SEED_ADMIN_NAME=Pharmacy Admin
# SEED_ADMIN_EMAIL=admin@pharmacy.com
# SEED_ADMIN_PASSWORD=Admin@123
# SEED_CUSTOMER_NAME=Demo Customer
# SEED_CUSTOMER_EMAIL=customer@pharmacy.com
# SEED_CUSTOMER_PASSWORD=Customer@123
